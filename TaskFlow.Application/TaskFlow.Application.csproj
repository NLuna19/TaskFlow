<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<!-- Referencias a capas permitidas -->
	<ItemGroup>
		<ProjectReference Include="..\TaskFlow.Domain\TaskFlow.Domain.csproj" />
	</ItemGroup>

	<!-- Paquetes recomendados para capa Application -->
	<ItemGroup>
		<!-- AutoMapper para DTOs y Mappings -->
		<PackageReference Include="AutoMapper.Extensions.Microsoft.DependencyInjection" Version="12.0.1" />

		<!-- FluentValidation para reglas de negocio simples (opcional pero recomendado) -->
		<PackageReference Include="FluentValidation" Version="12.1.0" />
		<PackageReference Include="FluentValidation.AspNetCore" Version="11.3.1" />
	</ItemGroup>

</Project>
